# Copy to .env and fill in your own keys. NEVER commit the real .env.
DEEPGRAM_API_KEY=your-deepgram-key            # STT — console.deepgram.com
CARTESIA_API_KEY=your-cartesia-key            # TTS — play.cartesia.ai
CARTESIA_VOICE_ID=1fcd23d0-bf12-4896-8f60-4f21ef5c9b98   # "Austin" — any Cartesia voice id works
CARTESIA_MODEL=sonic-3
HOMER_OC_HOST=0.0.0.0
HOMER_OC_PORT=7865
# The brain's OpenAI key does NOT go here — it lives in the OpenClaw profile
# (~/.openclaw-homer/agents/main/agent/auth-profiles.json) and the gateway
# systemd unit env. See examples/ and the README.
